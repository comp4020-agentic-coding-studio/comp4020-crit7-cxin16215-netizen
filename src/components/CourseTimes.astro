---
import type { CatalogCourse } from "../lib/scheduler";

interface Props {
  course: CatalogCourse;
}

const { course } = Astro.props;
---

<ul class="components">
  {
    course.components.map((component) => (
      <li>
        <span class="kind">{component.name}</span>
        {component.options.length === 0 ? (
          <span class="slots">no times listed</span>
        ) : component.options.length === 1 ? (
          <span class="slots">
            <span class="when">{component.options[0].label}</span> <span class="fixed">fixed</span>
          </span>
        ) : (
          <span class="slots">
            {/* A line may break between times, never inside one. */}
            one of{" "}
            {component.options.map((option, index) => (
              <>
                {index > 0 && " · "}
                <span class="when">{option.label}</span>
              </>
            ))}
          </span>
        )}
      </li>
    ))
  }
</ul>
